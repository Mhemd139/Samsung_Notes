{
  "name": "Inkport — your Samsung Notes, anywhere",
  "short_name": "Inkport",
  "description": "Open Samsung Notes files (.sdocx) on any device, export them to Markdown and PDF, or share them with any AI. Private: nothing is uploaded.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7fb",
  "theme_color": "#f6f7fb",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "files", "accept": ["*/*"] }] }
  },
  "file_handlers": [
    { "action": "./", "accept": { "application/octet-stream": [".sdocx"] } }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
